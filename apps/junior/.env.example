# 腾讯云 ASR (实时语音识别) 凭证
# 申请地址: https://console.cloud.tencent.com/cam/capi
#
# ⚠️ 仅 demo/本地开发用:直接把 SecretKey 放前端 .env.local 是不安全的,
# 生产环境必须走后端 STS 下发临时凭证 (tmpSecretId / tmpSecretKey / token)。
# 详见: https://cloud.tencent.com/document/product/1312/48195
#
# 复制这个文件为 .env.local 后填入自己的值。.env.local 已在 gitignore 里,不会被提交。

VITE_TENCENT_ASR_APPID=
VITE_TENCENT_ASR_SECRETID=
VITE_TENCENT_ASR_SECRETKEY=

# 阶跃 (Stepfun) TTS 凭证
# 申请地址: https://platform.stepfun.com/
# ⚠️ 同样仅 demo 用,生产环境应走后端代理,不要把 API Key 放前端。
VITE_STEP_API_KEY=
